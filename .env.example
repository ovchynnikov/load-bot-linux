# No inline comments or quotes: `docker run --env-file` keeps them as part of the value.

# Telegram Bot Configuration. Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# IDS to send Exceptions errors to in private messages. Get this from bot healthcheck with SEND_USER_INFO_WITH_HEALTHCHECK=True
# Comma-separated, e.g. ADMINS_CHAT_IDS=chatid_1,chatid_2,chatid_3
ADMINS_CHAT_IDS=your_admins_chat_id_here

# Send errors to admins in private messages
SEND_ERROR_TO_ADMIN=True

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Access Control Settings
# Restrict bot access to specific users/chats. Only false/0/no/off disable it; any other value restricts.
LIMIT_BOT_ACCESS=False

# Access Lists (only used if LIMIT_BOT_ACCESS=True)
# Usernames without @, e.g. ALLOWED_USERNAMES=user1,user2,user3
ALLOWED_USERNAMES=
# Personal or group chat IDs, e.g. ALLOWED_CHAT_IDS=186886480,-100987654321
ALLOWED_CHAT_IDS=
# Enable to use cookies file for Instagram login (instagram_cookies.txt). False by default.
INSTACOOKIES=False
# Enable to use cookies file for Reddit (reddit_cookies.txt). Reddit often requires login for videos. False by default.
REDDITCOOKIES=False

# Language Settings: en or uk (uk is the default when unset)
LANGUAGE=en

#CODEC TO USE libx264 or libx265
H_CODEC=libx265

# Send random messages with Chat ID and username to chat. If disabled - to log only
SEND_USER_INFO_WITH_HEALTHCHECK=False

# Enable to use GPU for video compression using Intel chip and VAAPI. False by default
USE_GPU_COMPRESSING=False

# Optional AI chat (requires a key for the selected provider)
# Optional LLM settings are validated only when USE_LLM=True.
USE_LLM=False
LLM_PROVIDER=grok
GROK_API_KEY=
# This replaces the previous code default grok-4-latest; existing Dokku overrides win.
GROK_MODEL=grok-4.3
GROK_REASONING_EFFORT=low
GROK_IMG_MODEL=grok-imagine-image

# Hosted web search is off until explicitly enabled; no separate search key needed.
GROK_WEB_SEARCH_ENABLED=False
# auto or explicit; "ботяра, web: ..." forces search in either mode
GROK_WEB_SEARCH_MODE=auto
GROK_WEB_SEARCH_RPD_LIMIT=20
GROK_WEB_SEARCH_GLOBAL_RPD_LIMIT=50
# Turns, not individual tool calls or a dollar cap
GROK_WEB_SEARCH_MAX_TURNS=3
GROK_REQUEST_TIMEOUT_SEC=120
GROK_SEARCH_TIMEOUT_SEC=75
GROK_FALLBACK_TIMEOUT_SEC=30
GROK_MAX_OUTPUT_TOKENS=4096

LLM_MAX_CONCURRENT_REQUESTS=2
LLM_MAX_PENDING_REQUESTS=10
# Total accepted jobs per user, active plus pending
LLM_MAX_JOBS_PER_USER=3
LLM_QUEUE_TIMEOUT_SEC=120
LLM_RPM_LIMIT=50
LLM_RPD_LIMIT=500
USE_CONVERSATION_CONTEXT=True
MAX_CONTEXT_MESSAGES=3
MAX_CONTEXT_CHARS=500

# Gemini chat does not use the Grok web search tool.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
